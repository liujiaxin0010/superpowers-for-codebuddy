{
  "version": "1.0.0",
  "dimensions": {
    "spec_coding": {
      "name": "Spec-Coding 规范",
      "maxScore": 10,
      "breakdownItems": [
        {
          "id": "requirement_clarification",
          "label": "需求澄清",
          "points": 2,
          "evidence": {
            "positive": [
              "编码前存在多轮需求问答",
              "明确提出了需求相关问题",
              "获得了用户对需求的确认"
            ],
            "keywords": [
              "requirement", "clarify", "confirm", "scope", "boundary",
              "需求", "澄清", "确认", "范围", "边界"
            ]
          }
        },
        {
          "id": "direction_evaluation",
          "label": "技术方向评估",
          "points": 2,
          "evidence": {
            "positive": [
              "对比了多个实现方案",
              "展示了权衡分析",
              "用户从选项中做出了选择"
            ],
            "keywords": [
              "option", "approach", "trade-off", "compare", "direction",
              "方案", "方向", "对比", "权衡", "选择"
            ]
          }
        },
        {
          "id": "spec_document",
          "label": "规格文档",
          "points": 2,
          "evidence": {
            "positive": [
              "在 docs/specs/ 下生成了规格文件",
              "调用了 /spec-lite 命令",
              "产出了 GateContext 或 TaskContract"
            ],
            "filePatterns": [
              "docs/specs/*-spec-lite.md",
              "docs/specs/*-spec.md"
            ]
          }
        },
        {
          "id": "implementation_plan",
          "label": "实施计划",
          "points": 2,
          "evidence": {
            "positive": [
              "在 docs/plans/ 下生成了计划文件",
              "调用了 /write-plan 命令",
              "包含批次/阶段的任务分解"
            ],
            "filePatterns": [
              "docs/plans/*-plan.md"
            ]
          }
        },
        {
          "id": "persistent_docs",
          "label": "持久化文档",
          "points": 1,
          "evidence": {
            "positive": [
              "维护并更新了 findings.md",
              "维护并更新了 progress.md"
            ],
            "filePatterns": [
              "docs/findings.md",
              "docs/progress.md"
            ]
          }
        },
        {
          "id": "gate_checks",
          "label": "质量门禁",
          "points": 1,
          "evidence": {
            "positive": [
              "执行前调用了门禁检查",
              "引用了 process-gatekeeper",
              "正确处理了 BLOCKED 状态"
            ],
            "keywords": [
              "gate", "gatekeeper", "blocked", "pass",
              "门禁", "阻断", "通过"
            ]
          }
        }
      ]
    },
    "skills_usage": {
      "name": "Skills/Agent 使用",
      "maxScore": 5,
      "scoringTable": [
        { "count": 0, "score": 0, "description": "未使用任何技能或 Agent" },
        { "count": 1, "score": 2, "description": "使用了 1 个技能或 Agent" },
        { "count": 2, "score": 3, "description": "使用了 2 个技能或 Agent" },
        { "count": 3, "score": 4, "description": "使用了 3 个技能或 Agent" },
        { "count": 4, "score": 5, "description": "使用了 4 个及以上不同的技能或 Agent" }
      ],
      "knownSkills": [
        "/Featureflow",
        "/spec-lite",
        "/write-plan",
        "/execute-plan",
        "/code-review",
        "/unified-test",
        "/test-gen",
        "/fix-bug",
        "/simplify",
        "/brainstorm",
        "/extend",
        "/research",
        "/status",
        "/doc-sync",
        "/pua",
        "/code-self-check",
        "/testcase",
        "/issue-draft-pr",
        "/parallel-delivery",
        "/score-interaction"
      ],
      "knownAgents": [
        "process-gatekeeper",
        "code-review-standards",
        "web-code-review",
        "devflow-router",
        "task-contracts",
        "file-based-memory",
        "xlsx"
      ]
    },
    "project_completion": {
      "name": "项目完成度",
      "maxScore": 10,
      "deliverableCount": 5,
      "pointsPerDeliverable": 2,
      "evidenceLevels": [
        {
          "level": "full",
          "label": "完整证据",
          "points": 2,
          "criteria": "代码存在 + 测试通过 + 展示了运行时验证"
        },
        {
          "level": "partial",
          "label": "部分证据",
          "points": 1,
          "criteria": "代码存在 + 编译/构建成功，但无运行时验证"
        },
        {
          "level": "none",
          "label": "无证据",
          "points": 0,
          "criteria": "代码缺失或损坏，无编译证据"
        }
      ],
      "negativeOverrides": [
        {
          "pattern": "user_reports_failure",
          "description": "用户明确报告功能不可用",
          "action": "无论代码是否存在，该交付物评 0 分"
        },
        {
          "pattern": "false_completion",
          "description": "AI 声称完成但未提供测试证据",
          "action": "该交付物最高评 1 分（部分）"
        },
        {
          "pattern": "bug_loop",
          "description": "同一 Bug 修复 3 次以上仍未解决",
          "action": "受影响的交付物扣 1 分"
        }
      ],
      "codeAnalysis": {
        "triggerCondition": "仅当提供 projectDir 参数时启用，否则降级回纯对话评分",
        "referenceDoc": "references/code-analysis-guide.md",
        "checks": [
          {
            "id": "file_existence",
            "label": "文件存在性",
            "description": "对话中声称的文件/模块是否在项目中真实存在",
            "impact": "文件不存在时该交付物降为 0 分"
          },
          {
            "id": "structure_completeness",
            "label": "结构完整性",
            "description": "项目是否具备该类型项目的标准目录结构",
            "impact": "缺失关键目录时降低完成度置信度"
          },
          {
            "id": "implementation_depth",
            "label": "实现充分性",
            "description": "关键函数/组件/API 是否有实际实现而非空壳",
            "impact": "空壳代码该交付物降为 partial（1 分）"
          },
          {
            "id": "test_coverage",
            "label": "测试覆盖",
            "description": "测试文件是否存在、测试用例数量是否合理",
            "impact": "有测试且用例 > 0 时增强 full evidence 置信度"
          },
          {
            "id": "dependency_integrity",
            "label": "依赖完整性",
            "description": "依赖声明文件是否存在且内容合理",
            "impact": "缺失依赖声明时降低可运行性置信度"
          },
          {
            "id": "build_feasibility",
            "label": "构建可行性",
            "description": "是否存在构建/启动配置和入口点",
            "impact": "缺少入口点时降低完成度置信度"
          }
        ],
        "crossValidation": [
          {
            "conversation": "声称完成 + 运行验证",
            "code": "代码存在且有实现",
            "result": "full",
            "points": 2
          },
          {
            "conversation": "声称完成 + 运行验证",
            "code": "代码不存在",
            "result": "partial",
            "points": 1,
            "note": "标记需人工确认"
          },
          {
            "conversation": "声称完成，无运行验证",
            "code": "代码存在且有实现",
            "result": "partial",
            "points": 1
          },
          {
            "conversation": "声称完成，无运行验证",
            "code": "代码为空壳或不存在",
            "result": "none",
            "points": 0,
            "note": "标记虚假完成"
          },
          {
            "conversation": "无明确声明",
            "code": "代码存在且有实现",
            "result": "partial",
            "points": 1
          },
          {
            "conversation": "用户报告失败",
            "code": "任意",
            "result": "none",
            "points": 0,
            "note": "用户反馈优先级最高"
          }
        ]
      }
    },
    "extended_features": {
      "name": "扩展功能与美化",
      "maxScore": 5,
      "subDimensions": {
        "extensions": {
          "label": "扩展功能",
          "maxScore": 2.5,
          "keywords": [
            "category", "tag", "priority", "search", "filter",
            "drag", "sort", "statistics", "localStorage", "dark mode",
            "preview", "batch", "real-time", "notification", "pagination",
            "export", "import", "keyboard shortcut",
            "分类", "标签", "优先级", "搜索", "筛选",
            "拖拽", "排序", "统计", "本地存储", "深色模式",
            "预览", "批量", "实时", "通知", "分页",
            "导出", "导入", "快捷键"
          ]
        },
        "beautification": {
          "label": "界面美化",
          "maxScore": 2.5,
          "keywords": [
            "responsive", "animation", "transition", "theme",
            "icon", "media query", "mobile", "grid",
            "Ant Design", "Element Plus", "Naive UI", "Material UI",
            "Tailwind", "Bootstrap", "card", "panel", "layout",
            "响应式", "动画", "主题", "图标", "移动端适配"
          ]
        }
      },
      "bugPenalty": {
        "description": "扩展功能中存在已知 Bug 时扣分",
        "deduction": 0.5
      }
    }
  },
  "antiPatterns": {
    "false_completion": {
      "label": "虚假完成",
      "detection": "声称任务完成但未运行验证命令",
      "impact": "在项目完成度维度中扣分"
    },
    "premature_coding": {
      "label": "过早编码",
      "detection": "未经任何规划或需求讨论直接编码",
      "impact": "在 Spec-Coding 规范维度中扣分"
    },
    "bug_loop": {
      "label": "Bug 修复循环",
      "detection": "同一问题修复 3 次以上仍未解决",
      "impact": "在项目完成度维度中扣分"
    },
    "ignored_user_feedback": {
      "label": "忽略用户反馈",
      "detection": "用户报告问题但 AI 未解决或无证据地声称已修复",
      "impact": "在项目完成度维度中扣分"
    },
    "false_code_claim": {
      "label": "代码虚报",
      "detection": "对话声称已完成功能，但代码分析显示文件不存在或仅为空壳实现",
      "impact": "在项目完成度维度中扣分，标记为虚假完成",
      "requiresCodeAnalysis": true
    }
  },
  "scoreLevels": [
    { "level": "优秀", "min": 25, "max": 30, "description": "流程合规、功能完整、界面精致" },
    { "level": "良好", "min": 19, "max": 24, "description": "基本合规、核心功能可用、存在小缺陷" },
    { "level": "合格", "min": 13, "max": 18, "description": "部分合规、部分功能可用、存在明显缺陷" },
    { "level": "待改进", "min": 0, "max": 12, "description": "流程、功能或两者均存在显著差距" }
  ],
  "outputConfig": {
    "defaultOutputDir": "docs/scoring/",
    "filenamePattern": "{name}_{id}_{task}",
    "filenamePatternDescription": "姓名_工号_需求名称",
    "filenameExample": "张三_10086_文件映射服务",
    "reportExtension": ".md",
    "xlsxExtension": ".xlsx",
    "requiredFields": ["name", "id", "task"],
    "requiredFieldsDescription": "如果缺少姓名、工号或需求名称，必须在评分前向用户询问",
    "xlsxColumns": [
      { "header": "评分维度", "field": "dimension", "width": 25 },
      { "header": "满分", "field": "maxScore", "width": 10 },
      { "header": "得分", "field": "actualScore", "width": 10 },
      { "header": "得分率", "field": "scoreRate", "width": 12 },
      { "header": "关键证据", "field": "evidence", "width": 50 },
      { "header": "扣分原因", "field": "deductions", "width": 40 },
      { "header": "改进建议", "field": "suggestions", "width": 40 }
    ],
    "xlsxFormatting": {
      "headerStyle": {
        "bold": true,
        "backgroundColor": "B8CCE4",
        "freezeFirstRow": true
      },
      "scoreRateConditional": {
        "green": ">= 0.8",
        "yellow": ">= 0.6",
        "red": "< 0.6"
      }
    }
  }
}
