{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://featureflow.local/schemas/findings.schema.json",
  "title": "docs/findings.md 结构契约",
  "description": "findings.md 必备段落清单；用 markdown 标题作为锚点校验。",
  "type": "object",
  "required": [
    "requirementsHeading",
    "findingsHeading",
    "decisionsHeading",
    "issuesHeading",
    "resourcesHeading"
  ],
  "properties": {
    "requirementsHeading": {
      "type": "string",
      "pattern": "## 需求摘要"
    },
    "findingsHeading": {
      "type": "string",
      "pattern": "## 研究发现"
    },
    "decisionsHeading": {
      "type": "string",
      "pattern": "## 技术决策"
    },
    "issuesHeading": {
      "type": "string",
      "pattern": "## 遇到的问题"
    },
    "resourcesHeading": {
      "type": "string",
      "pattern": "## 资源链接"
    }
  },
  "additionalProperties": true
}
